# ─────────────────────────────────────────────────────────────
#  VitalWatch backend settings
#  Copy this file to ".env" and fill in your keys.
#  Your old .env still works. Just add the new lines below.
# ─────────────────────────────────────────────────────────────

PORT=5000

# ── Firebase (optional) ──────────────────────────────────────
# Leave empty to run in memory only (works fully offline).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Save one vitals record every N seconds (keeps you inside the free quota)
PERSIST_INTERVAL_SEC=10

# ── USB receiver (ESP32 + RA-02) ─────────────────────────────
# "auto" = find the ESP32 by itself. Or force a port: COM3 / /dev/ttyUSB0
SERIAL_PORT=auto
SERIAL_BAUD=115200

# AES-128 key. Must be exactly 16 characters and the same on the band.
AES_KEY=VitalWatch12345!

# ── Band behaviour ───────────────────────────────────────────
# Band sends a packet every 5 s. Mark "signal lost" after this many seconds.
BAND_TIMEOUT_SEC=20
# If a sensor on the band fails, fill its value with a realistic estimate
# (only while real packets are arriving). Estimated values are tagged "SIM".
FILL_FAILED_SENSORS=true
# Show the "Test mode" band simulator button on the System page.
ALLOW_SIMULATOR=true
# Sea-level pressure used to turn BMP280 pressure into altitude (hPa)
SEA_LEVEL_HPA=1013.25
# Map position used when GPS has no fix (base camp)
BASE_LAT=34.1526
BASE_LNG=77.5771

# ── AI analysis (free providers, tried in this order) ────────
LLM_ENABLED=true
LLM_PROVIDERS=groq,gemini,openrouter

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (last backup, 50 free calls/day): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Minimum / maximum seconds between AI analyses while the band is live
LLM_MIN_INTERVAL_SEC=20
LLM_MAX_INTERVAL_SEC=180
